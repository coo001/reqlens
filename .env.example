# Free-tier Gemini API key. Never commit the real value.
GEMINI_API_KEY=
# Optional switches (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash
# COMPARE_VERSION=compare-v2 # comparison prompt used by the app (compare-v1|v2|v3)
# REPLAY=0          # 1 = never call the model, answer only from runs/
# RECORD=1          # 0 = do not save live responses to runs/
# DAILY_CALL_CAP=13 # live calls per day (KST) before the server refuses
